{
  "ConnectionStrings": {
    "CortexDatabase": "Host=localhost;Port=5432;Database=cortex_db;Username=cortex;Password=cortex_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cortex",
    "Password": "cortex_dev",
    "QueueName": "ai_extraction_queue",
    "DeadLetterExchange": "cortex.ai.dlx",
    "DeadLetterQueueName": "ai_extraction_dead_letter_queue",
    "RetryDelaySeconds": 10
  },
  "Jwt": {
    "SecretKey": "development-only-secret-key-change-before-production-64-characters",
    "Issuer": "Cortex.API",
    "Audience": "Cortex.Clients",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AIService": {
    "OpenAIApiKey": "",
    "EmbeddingModel": "text-embedding-3-small",
    "CompletionModel": "gpt-4o-mini",
    "MaxRetries": 3,
    "TimeoutSeconds": 60
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "cortex-content"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cortex-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
