{
  "ConnectionStrings": {
    "CortexDatabase": "Host=localhost;Port=5432;Database=cortex_db;Username=cortex;Password=cortex_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "Neo4j": {
    "Uri": "bolt://localhost:7687",
    "Username": "neo4j",
    "Password": "cortex_graph_pass"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cortex",
    "Password": "cortex_dev",
    "ExtractionQueueName": "ai_extraction_queue",
    "BehaviorQueueName": "behavior_events_queue",
    "DeadLetterExchange": "cortex.ai.dlx",
    "DeadLetterQueueName": "ai_extraction_dead_letter_queue",
    "RetryDelaySeconds": 10
  },
  "Jwt": {
    "SecretKey": "development-only-secret-key-change-before-production-64-characters",
    "Issuer": "Cortex.API",
    "Audience": "Cortex.Clients",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Auth": {
    "RequireOtpVerification": false
  },
  "AIService": {
    "ActiveProvider": "Gemini",
    "Gemini": {
      "OpenAIApiKey": "",
      "EndpointUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "EmbeddingModel": "gemini-embedding-2",
      "CompletionModel": "gemini-2.0-flash-lite",
      "MaxRetries": 3,
      "TimeoutSeconds": 60
    },
    "LocalOllama": {
      "OpenAIApiKey": "",
      "EndpointUrl": "http://localhost:11434/v1/",
      "EmbeddingModel": "nomic-embed-text",
      "CompletionModel": "llama3",
      "VisionModel": "llava",
      "MaxRetries": 3,
      "TimeoutSeconds": 120
    }
  },
  "LocalExtraction": {
    "YtDlpPath": "/Users/apple/Desktop/refind/refind/ai-service/venv/bin/yt-dlp",
    "FfmpegPath": "/usr/local/bin/ffmpeg",
    "WhisperModelPath": "whisper-models/ggml-base.en.bin",
    "WhisperModelType": "LargeV3",
    "TempDirectory": "/tmp/cortex-media",
    "UseGeminiVideoAnalysis": true,
    "Enabled": true
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "cortex-content"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cortex-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}